generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Rôle du compte
enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

// Étape de vérification du compte
enum UserStatus {
  INCOMPLETE
  PENDING_REVIEW
  VERIFIED
  SUSPENDED
  REJECTED
}

// Niveau d'un administrateur
enum AdminLevel {
  SUPPORT
  FINANCE
  SUPER
}

// Particulier ou entreprise
enum ClientType {
  INDIVIDUAL
  COMPANY
}

// Mode de versement du fournisseur
enum PayoutMethod {
  BANK_TRANSFER
  MOBILE_MONEY
}

// Document juridique accepté
enum ConsentType {
  TERMS
  PRIVACY
  PROVIDER_CONTRACT
}

// Pièces justificatives d'un compte
enum DocumentType {
  ID_FRONT
  ID_BACK
  COMPANY_REGISTRATION
  HEADQUARTERS_PROOF
  BANK_PROOF
  INSURANCE
}

// Pièces justificatives d'un engin
enum MachineDocType {
  OWNERSHIP_PROOF
  INSURANCE
  TECHNICAL_INSPECTION
}

// Résultat de la revue d'un document
enum DocStatus {
  PENDING
  VALID
  REFUSED
}

// Étape de publication d'un engin
enum MachineStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

// Cycle de vie d'une réservation
enum ReservationStatus {
  PENDING_PROVIDER
  AWAITING_DEPOSIT
  CONFIRMED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

// État global du paiement
enum PaymentStatus {
  PENDING
  DEPOSIT_HELD
  FULLY_HELD
  RELEASED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
}

// État de la caution
enum CautionStatus {
  NOT_PAID
  HELD
  RELEASED
  CAPTURED
}

// Moyen de paiement du client
enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

// Type de mouvement financier
enum TransactionType {
  DEPOSIT
  BALANCE
  CAUTION_HOLD
  CAUTION_RELEASE
  CAUTION_CAPTURE
  COMMISSION
  PAYOUT
  REFUND
}

// État d'une tentative de paiement
enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Étape du transport de l'engin
enum TrackingStatus {
  EN_ROUTE
  ON_SITE
  RETURNING
  DELIVERED
}

// Avancement d'un litige
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

// Décision de l'admin sur un litige
enum DisputeResolution {
  RELEASE_TO_PROVIDER
  REFUND_CLIENT
  SPLIT
}

// Compte (client, fournisseur ou admin)
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  phone String @unique
  birthDate DateTime @db.Date
  nationality String
  role Role
  status UserStatus @default(INCOMPLETE)
  idNumberEncrypted String
  idNumberHash String @unique
  idIssuingCountry String
  isCommissionFree Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  clientProfile ClientProfile?
  providerProfile ProviderProfile?
  adminProfile AdminProfile?
  address Address?
  consents ConsentRecord[]
  documents Document[] @relation("DocumentOwner")
  reviewedDocuments Document[] @relation("DocumentReviewedBy")
  machines Machine[]
  operators Operator[]
  sessions Session[]
  accounts Account[]
  clientReservations Reservation[] @relation("ReservationClient")
  providerReservations Reservation[] @relation("ReservationProvider")
  cancelledReservations Reservation[] @relation("ReservationCancelledBy")
  openedDisputes Dispute[] @relation("DisputeOpenedBy")
  resolvedDisputes Dispute[] @relation("DisputeResolvedBy")
  commissionSettings CommissionSetting[]
  auditLogs AuditLog[]
}

// Profil d'un administrateur
model AdminProfile {
  id String @id @default(cuid())
  userId String @unique
  level AdminLevel

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Profil d'un client
model ClientProfile {
  id String @id @default(cuid())
  userId String @unique
  clientType ClientType
  companyName String?
  companyRegistration String?
  taxId String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Profil d'un fournisseur
model ProviderProfile {
  id String @id @default(cuid())
  userId String @unique
  companyName String
  registrationNumber String
  registrationCountry String
  headquartersCity String
  headquartersAddress String
  taxId String?
  payoutMethod PayoutMethod
  payoutAccountEncrypted String
  payoutAccountHash String @unique
  accountHolderName String
  payoutVerifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Adresse de résidence
model Address {
  id String @id @default(cuid())
  userId String @unique
  country String
  city String
  fullAddress String
  postalCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Preuve d'acceptation des CGU et contrats
model ConsentRecord {
  id String @id @default(cuid())
  userId String
  documentType ConsentType
  version String
  acceptedAt DateTime @default(now())
  ipAddress String
  userAgent String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// Pièces justificatives d'un compte
model Document {
  id String @id @default(cuid())
  userId String
  type DocumentType
  storageKey String
  mimeType String
  sizeBytes Int
  checksum String
  status DocStatus @default(PENDING)
  refusalReason String?
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

// Catégorie d'engin
model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  isHeavy Boolean
  isActive Boolean @default(true)

  machines Machine[]
}

// Engin proposé par un fournisseur
model Machine {
  id String @id @default(cuid())
  providerId String
  categoryId String
  name String
  brand String
  capacity String
  speed Decimal @db.Decimal(10, 2)
  power Decimal @db.Decimal(10, 2)
  dailyPrice BigInt
  currency String @default("XOF")
  transportFee BigInt
  cautionRate Decimal @default(10.00) @db.Decimal(5, 2)
  fuelIncluded Boolean @default(false)
  city String
  country String
  description String?
  isAvailable Boolean @default(false)
  reviewStatus MachineStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  provider User @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images MachineImage[]
  documents MachineDocument[]
  reservations Reservation[]

  @@index([providerId])
  @@index([categoryId])
  @@index([reviewStatus, isAvailable])
}

// Photos d'un engin
model MachineImage {
  id String @id @default(cuid())
  machineId String
  storageKey String
  position Int

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
}

// Pièces d'un engin (assurance, propriété, contrôle)
model MachineDocument {
  id String @id @default(cuid())
  machineId String
  type MachineDocType
  storageKey String
  status DocStatus @default(PENDING)
  expiresAt DateTime? @db.Date

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@index([machineId])
  @@index([type, expiresAt])
}

// Opérateur qualifié d'un fournisseur
model Operator {
  id String @id @default(cuid())
  providerId String
  fullName String
  phone String
  licenseNumberEncrypted String
  qualificationDocumentKey String
  isActive Boolean @default(true)
  deletedAt DateTime?

  provider User @relation(fields: [providerId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([providerId])
}

// Session de connexion (Better-Auth)
model Session {
  id String @id @default(cuid())
  token String @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Identifiants de connexion et mot de passe haché (Better-Auth)
model Account {
  id String @id @default(cuid())
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Codes de vérification email et mot de passe oublié (Better-Auth)
model Verification {
  id String @id @default(cuid())
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// Commande de location d'un client
model Reservation {
  id String @id @default(cuid())
  reference String @unique
  clientId String
  providerId String
  machineId String
  operatorId String?
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  daysCount Int
  machineName String
  machineBrand String
  dailyPriceSnapshot BigInt
  transportFeeSnapshot BigInt
  totalAmount BigInt
  currency String
  siteCountry String
  siteCity String
  siteAddress String
  siteLatitude Decimal? @db.Decimal(9, 6)
  siteLongitude Decimal? @db.Decimal(9, 6)
  status ReservationStatus @default(PENDING_PROVIDER)
  expiresAt DateTime?
  cancelledById String?
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation("ReservationClient", fields: [clientId], references: [id], onDelete: Restrict)
  provider User @relation("ReservationProvider", fields: [providerId], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  payment Payment?
  trackingPoints TrackingPoint[]
  disputes Dispute[]

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([machineId, startDate, endDate])
}

// Séquestre, caution et commission d'une réservation
model Payment {
  id String @id @default(cuid())
  reservationId String @unique
  currency String
  totalAmount BigInt
  depositRate Decimal @default(40.00) @db.Decimal(5, 2)
  depositAmount BigInt
  balanceAmount BigInt
  balanceDueDate DateTime @db.Date
  sequesteredAmount BigInt @default(0)
  commissionRate Decimal @db.Decimal(5, 2)
  commissionAmount BigInt
  providerPayoutAmount BigInt
  cautionAmount BigInt
  cautionStatus CautionStatus @default(NOT_PAID)
  status PaymentStatus @default(PENDING)
  method PaymentMethod?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  attempts PaymentAttempt[]
}

// Journal financier (jamais modifié)
model PaymentTransaction {
  id String @id @default(cuid())
  paymentId String
  type TransactionType
  amount BigInt
  currency String
  providerReference String @unique
  idempotencyKey String @unique
  webhookPayloadHash String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

// Tentatives de paiement en cours ou échouées
model PaymentAttempt {
  id String @id @default(cuid())
  paymentId String
  idempotencyKey String @unique
  status PaymentAttemptStatus @default(PENDING)
  providerReference String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

// Historique du taux de commission
model CommissionSetting {
  id String @id @default(cuid())
  rate Decimal @db.Decimal(5, 2)
  effectiveFrom DateTime
  setById String
  reason String
  createdAt DateTime @default(now())

  setBy User @relation(fields: [setById], references: [id], onDelete: Restrict)

  @@index([effectiveFrom])
}

// Historique des positions GPS
model TrackingPoint {
  id String @id @default(cuid())
  reservationId String
  latitude Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  status TrackingStatus @default(EN_ROUTE)
  recordedAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, recordedAt])
}

// Litige sur une réservation
model Dispute {
  id String @id @default(cuid())
  reservationId String
  openedById String
  reason String
  evidenceKeys String[]
  status DisputeStatus @default(OPEN)
  resolution DisputeResolution?
  splitProviderAmount BigInt?
  resolutionNote String?
  resolvedById String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  openedBy User @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([status])
}

// Journal d'audit des actions sensibles
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json?
  ipAddress String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}